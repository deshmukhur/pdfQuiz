# ─── DATABASE ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_platform

# ─── FYERS API ───────────────────────────────────────────────────────
FYERS_CLIENT_ID=your_fyers_client_id
FYERS_SECRET=your_fyers_secret_key
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/fyers/callback

# ─── NEWS (Optional — leave empty for RSS-only mode) ─────────────────
NEWSAPI_KEY=

# ─── SECURITY ────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key

# ─── APPLICATION ─────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SCAN_INTERVAL_SECONDS=60
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
